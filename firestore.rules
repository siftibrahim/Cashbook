rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ----------------------------------------------------
    // SECURITY HELPER FUNCTIONS
    // ----------------------------------------------------
    
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'siftibrahim@gmail.com' ||
        request.auth.token.email == 'admin@twing.com' ||
        request.auth.token.admin == true
      );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // ----------------------------------------------------
    // 1. STORE & LEDGER COLLECTIONS (Multi-tenant data)
    // ----------------------------------------------------

    // Stores collection (profile information)
    match /stores/{storeId} {
      allow read: if true;
      allow write: if isSignedIn() || isAdmin();
    }

    // Customers collection
    match /customers/{customerId} {
      allow read, write: if true;
    }

    // Transactions collection
    match /transactions/{txId} {
      allow read, write: if true;
    }

    // Daily Expenses collection
    match /expenses/{expenseId} {
      allow read, write: if true;
    }

    // ----------------------------------------------------
    // 2. ADMIN & USER MANAGEMENT COLLECTIONS
    // ----------------------------------------------------

    // Admin Users collection
    match /admin_users/{userId} {
      allow read: if true;
      allow write: if true;
    }

    // Admin Payments collection
    match /admin_payments/{paymentId} {
      // Users can submit payments, admins/staff can review
      allow read: if true;
      allow create: if true;
      allow update, delete: if true;
    }

    // Staff Members collection (Admin Staff Access Control)
    match /staff_members/{staffId} {
      allow read: if true;
      allow write: if true;
    }

    // Admin Notifications collection
    match /admin_notifications/{notifId} {
      allow read: if true;
      allow write: if true;
    }

    // Admin Announcements collection (Publicly visible notice board)
    match /admin_announcements/{announcementId} {
      allow read: if true;
      allow write: if true;
    }

    // Admin Config (App update, system settings)
    match /admin_config/{configId} {
      allow read: if true;
      allow write: if true;
    }

    // System Config (Payment settings, gateways, system variables)
    match /system_config/{configId} {
      allow read: if true;
      allow write: if true;
    }

    // Admin Activity Logs collection
    match /admin_activity_logs/{logId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if true;
    }

    // ----------------------------------------------------
    // 3. SUPPORT HELPDESK COLLECTIONS
    // ----------------------------------------------------

    // Support Threads collection
    match /support_threads/{threadId} {
      allow read: if true;
      allow write: if true;
    }

    // Support Messages collection
    match /support_messages/{messageId} {
      allow read: if true;
      allow write: if true;
    }

    // ----------------------------------------------------
    // 4. USER SPECIFIC SCOPED DOCUMENTS
    // ----------------------------------------------------
    match /users/{userId}/{document=**} {
      allow read, write: if true;
    }

    // ----------------------------------------------------
    // 5. MASTER GATE DEFAULT RULE (Safety Net)
    // ----------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
