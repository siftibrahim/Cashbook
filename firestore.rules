rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Stores collection (profile information)
    match /stores/{storeId} {
      allow read, write: if true;
    }

    // Customers collection
    match /customers/{customerId} {
      allow read, write: if true;
    }

    // Transactions collection
    match /transactions/{txId} {
      allow read, write: if true;
    }

    // Daily Expenses collection
    match /expenses/{expenseId} {
      allow read, write: if true;
    }

    // Admin Users collection
    match /admin_users/{userId} {
      allow read, write: if true;
    }

    // Admin Payments collection
    match /admin_payments/{paymentId} {
      allow read, write: if true;
    }

    // Admin Notifications collection
    match /admin_notifications/{notifId} {
      allow read, write: if true;
    }

    // Admin Announcements collection
    match /admin_announcements/{announcementId} {
      allow read, write: if true;
    }

    // Admin Config (App update, system settings)
    match /admin_config/{configId} {
      allow read, write: if true;
    }

    // Admin Activity Logs collection
    match /admin_activity_logs/{logId} {
      allow read, write: if true;
    }

    // Support Threads collection
    match /support_threads/{threadId} {
      allow read, write: if true;
    }

    // Support Messages collection
    match /support_messages/{messageId} {
      allow read, write: if true;
    }

    // Scoped by user ID for multi-tenant support
    match /users/{userId}/{document=**} {
      allow read, write: if true;
    }

    // Fallback
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
