{
  "entities": {
    "User": {
      "title": "User",
      "description": "Registered app user with shop profile and account status",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique user ID" },
        "name": { "type": "string", "description": "User full name" },
        "phone": { "type": "string", "description": "User mobile phone number" },
        "email": { "type": "string", "description": "User email address" },
        "shopName": { "type": "string", "description": "Shop or business name" },
        "businessType": { "type": "string", "description": "Type of business / shop" },
        "address": { "type": "string", "description": "Shop address" },
        "role": { "type": "string", "enum": ["super_admin", "admin", "manager", "user"], "description": "User role" },
        "status": { "type": "string", "enum": ["active", "expired", "suspended", "pending"], "description": "Account status" },
        "subscriptionPlan": { "type": "string", "description": "Current plan name" },
        "subscriptionStatus": { "type": "string", "enum": ["trial", "active", "expiring_soon", "expired", "suspended"], "description": "Subscription status" },
        "subscriptionExpiresAt": { "type": "number", "description": "Timestamp of expiration" },
        "registeredAt": { "type": "number", "description": "Timestamp of account registration" },
        "lastActiveAt": { "type": "number", "description": "Timestamp of last app usage" },
        "totalCustomers": { "type": "number", "description": "Customer count" },
        "totalTransactions": { "type": "number", "description": "Transaction count" },
        "notes": { "type": "string", "description": "Admin notes on user" }
      },
      "required": ["id", "name", "phone", "email", "shopName", "status"]
    },
    "Payment": {
      "title": "Payment",
      "description": "Subscription payment request or transaction record",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Payment ID" },
        "userId": { "type": "string", "description": "User ID" },
        "userName": { "type": "string", "description": "User Name" },
        "userPhone": { "type": "string", "description": "User Phone" },
        "shopName": { "type": "string", "description": "Shop Name" },
        "planId": { "type": "string", "description": "Subscription plan ID" },
        "planName": { "type": "string", "description": "Subscription plan name" },
        "durationDays": { "type": "number", "description": "Validity period in days" },
        "amount": { "type": "number", "description": "Payment amount in BDT" },
        "paymentMethod": { "type": "string", "enum": ["bkash", "nagad", "rocket", "bank", "cash", "other"], "description": "MFS or Bank" },
        "trxId": { "type": "string", "description": "Transaction ID from MFS or Bank" },
        "senderNumber": { "type": "string", "description": "Customer sender account number" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"], "description": "Verification status" },
        "createdAt": { "type": "number", "description": "Submission timestamp" },
        "approvedAt": { "type": "number", "description": "Approval timestamp" },
        "adminNotes": { "type": "string", "description": "Admin comments or reason" }
      },
      "required": ["id", "userId", "amount", "paymentMethod", "status", "createdAt"]
    },
    "StaffMember": {
      "title": "StaffMember",
      "description": "Admin staff member record with RBAC permissions",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Staff ID" },
        "name": { "type": "string", "description": "Staff Name" },
        "phone": { "type": "string", "description": "Staff phone number" },
        "email": { "type": "string", "description": "Staff email" },
        "role": { "type": "string", "enum": ["staff", "manager"], "description": "Staff role" },
        "status": { "type": "string", "enum": ["active", "disabled"], "description": "Staff status" },
        "permissions": { "type": "array", "items": { "type": "string" }, "description": "Assigned granular permissions" },
        "createdAt": { "type": "number", "description": "Created timestamp" },
        "lastActiveAt": { "type": "number", "description": "Last active timestamp" },
        "notes": { "type": "string", "description": "Notes" },
        "createdBy": { "type": "string", "description": "Super admin who created staff" }
      },
      "required": ["id", "name", "phone", "email", "role", "status", "permissions", "createdAt"]
    },
    "Notification": {
      "title": "Notification",
      "description": "Admin broadcast or user-specific notification",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Notification ID" },
        "title": { "type": "string", "description": "Notification title" },
        "message": { "type": "string", "description": "Message content" },
        "type": { "type": "string", "enum": ["general", "subscription_warning", "subscription_expired", "update", "payment_receipt", "security"], "description": "Notification type" },
        "target": { "type": "string", "enum": ["all", "active", "expired", "specific"], "description": "Audience" },
        "targetUserId": { "type": "string", "description": "Specific User ID if targeted" },
        "priority": { "type": "string", "enum": ["low", "normal", "high", "urgent"], "description": "Urgency" },
        "createdAt": { "type": "number", "description": "Creation timestamp" },
        "isRead": { "type": "boolean", "description": "Read status" }
      },
      "required": ["id", "title", "message", "type", "target", "createdAt"]
    },
    "Announcement": {
      "title": "Announcement",
      "description": "Global announcement banner or popup notice",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Announcement ID" },
        "title": { "type": "string", "description": "Headline" },
        "message": { "type": "string", "description": "Detailed text or guidelines" },
        "priority": { "type": "string", "enum": ["info", "warning", "success", "alert"], "description": "Visual style" },
        "isActive": { "type": "boolean", "description": "Whether active" },
        "showAsPopup": { "type": "boolean", "description": "Display as modal dialog" },
        "createdAt": { "type": "number", "description": "Created date" },
        "expiresAt": { "type": "number", "description": "Expiry date" }
      },
      "required": ["id", "title", "message", "isActive", "createdAt"]
    },
    "AppUpdate": {
      "title": "AppUpdate",
      "description": "App version release management and force update settings",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Configuration ID" },
        "versionName": { "type": "string", "description": "Current version string e.g. 2.4.0" },
        "versionCode": { "type": "number", "description": "Numeric version code e.g. 24" },
        "minRequiredVersion": { "type": "string", "description": "Minimum allowed version" },
        "isForceUpdate": { "type": "boolean", "description": "Enforce mandatory update" },
        "updateTitle": { "type": "string", "description": "Prompt heading" },
        "releaseNotes": { "type": "string", "description": "Changelog and new features" },
        "downloadUrl": { "type": "string", "description": "Download APK or store URL" },
        "updatedAt": { "type": "number", "description": "Last update timestamp" }
      },
      "required": ["id", "versionName", "isForceUpdate", "updatedAt"]
    },
    "ActivityLog": {
      "title": "ActivityLog",
      "description": "Audit trail log of actions taken by admin or system",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Log ID" },
        "adminEmail": { "type": "string", "description": "Admin email who performed action" },
        "action": { "type": "string", "description": "Action type e.g. USER_SUSPENDED, PAYMENT_APPROVED" },
        "targetEntity": { "type": "string", "description": "Entity affected" },
        "targetId": { "type": "string", "description": "Target document ID" },
        "details": { "type": "string", "description": "Human readable details in Bengali/English" },
        "timestamp": { "type": "number", "description": "Log timestamp" }
      },
      "required": ["id", "adminEmail", "action", "details", "timestamp"]
    },
    "SupportThread": {
      "title": "SupportThread",
      "description": "Customer support ticket and conversation thread",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Thread ID" },
        "userId": { "type": "string", "description": "User ID" },
        "userName": { "type": "string", "description": "User Name" },
        "userPhone": { "type": "string", "description": "User Phone" },
        "shopName": { "type": "string", "description": "Shop Name" },
        "lastMessage": { "type": "string", "description": "Last message snippet" },
        "lastSender": { "type": "string", "enum": ["user", "admin"], "description": "Last sender" },
        "updatedAt": { "type": "number", "description": "Timestamp" },
        "status": { "type": "string", "enum": ["open", "closed"], "description": "Thread status" },
        "unreadAdminCount": { "type": "number", "description": "Unread messages for admin" },
        "unreadUserCount": { "type": "number", "description": "Unread messages for user" }
      },
      "required": ["id", "userId", "shopName", "status", "updatedAt"]
    },
    "SupportMessage": {
      "title": "SupportMessage",
      "description": "Message within a support ticket",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Message ID" },
        "userId": { "type": "string", "description": "User ID" },
        "sender": { "type": "string", "enum": ["user", "admin"], "description": "Sender role" },
        "senderName": { "type": "string", "description": "Sender Name" },
        "text": { "type": "string", "description": "Message body" },
        "createdAt": { "type": "number", "description": "Creation timestamp" },
        "isReadByAdmin": { "type": "boolean", "description": "Read by admin" },
        "isReadByUser": { "type": "boolean", "description": "Read by user" }
      },
      "required": ["id", "userId", "sender", "text", "createdAt"]
    }
  },
  "firestore": {
    "/admin_users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "Registered shop users managed by Admin"
    },
    "/admin_payments/{paymentId}": {
      "schema": { "$ref": "#/entities/Payment" },
      "description": "Subscription payment requests"
    },
    "/staff_members/{staffId}": {
      "schema": { "$ref": "#/entities/StaffMember" },
      "description": "Admin staff accounts and RBAC access permissions"
    },
    "/admin_notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/Notification" },
      "description": "Admin notifications and alerts"
    },
    "/admin_announcements/{announcementId}": {
      "schema": { "$ref": "#/entities/Announcement" },
      "description": "App notices and broadcast banners"
    },
    "/admin_config/app_update": {
      "schema": { "$ref": "#/entities/AppUpdate" },
      "description": "Global app update and version control"
    },
    "/admin_activity_logs/{logId}": {
      "schema": { "$ref": "#/entities/ActivityLog" },
      "description": "Admin audit activity trail"
    },
    "/support_threads/{threadId}": {
      "schema": { "$ref": "#/entities/SupportThread" },
      "description": "User support helpdesk threads"
    },
    "/support_messages/{messageId}": {
      "schema": { "$ref": "#/entities/SupportMessage" },
      "description": "Support helpdesk chat messages"
    },
    "/stores/{storeId}": {
      "description": "Shop owner profile"
    },
    "/customers/{customerId}": {
      "description": "Shop customers database"
    },
    "/transactions/{transactionId}": {
      "description": "Shop customer transaction records"
    },
    "/expenses/{expenseId}": {
      "description": "Shop daily expenses"
    }
  }
}
