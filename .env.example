# Optional environment variables
# Note: The app includes built-in defaults and works out of the box.
# If you want to connect external services, you can configure them below:

# Optional external PostgreSQL connection string:
# DATABASE_URL=

# Paymently Payment Gateway (Server-Side Only)
# Base URL provided: https://twinghisabi.paymently.io/api
PAYMENTLY_BASE_URL=https://twinghisabi.paymently.io/api
# Secret API Key from Paymently merchant dashboard:
PAYMENTLY_API_KEY=
