# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# DATABASE_URL: Connection string for Neon PostgreSQL database (e.g. postgresql://user:pass@ep-xyz.region.aws.neon.tech/neondb?sslmode=require)
DATABASE_URL=

# JWT_SECRET: Secret key used to sign and verify JSON Web Tokens
JWT_SECRET=

# SMS GATEWAY SETTINGS: For sending real SMS OTP to Bangladeshi mobile numbers (e.g. Greenweb, BulkSMSBD, AlphaSMS)
GREENWEB_SMS_TOKEN=
BULKSMSBD_API_KEY=
SMS_API_KEY=
SMS_SENDER_ID=
SMS_PROVIDER=greenweb
