# DATABASE_URL: Neon PostgreSQL connection string (Required for server/cloud persistence)
DATABASE_URL="postgresql://username:password@ep-sample-pooler.aws.neon.tech/neondb?sslmode=require"

# JWT_SECRET: Secret key for signing authentication tokens
JWT_SECRET="your-secure-jwt-secret-key-min-32-chars"

# ADMIN_EMAIL & ADMIN_PASSWORD: Default Super Admin initial credentials
ADMIN_EMAIL="admin@twing.com"
ADMIN_PASSWORD="your-secure-admin-password"

# VITE_API_URL: (Optional) Frontend remote API base URL if frontend and backend are hosted on separate domains
# Example: https://twing-backend.onrender.com (leave empty if full-stack or same domain)
VITE_API_URL=""

# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
APP_URL=""

